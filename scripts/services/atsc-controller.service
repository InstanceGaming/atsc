[Unit]
Description=Actuated Traffic Signal Controller (ATSC)

[Service]
Type=forking

WorkingDirectory=%h/atsc-async/
ExecStart=/bin/sh %h/atsc-async/scripts/services/start-controller.sh
ExecStop=/bin/sh %h/atsc-async/scripts/services/stop-controller.sh

TimeoutStartSec=30
TimeoutStopSec=30

MemoryMax=64M
CPUQuota=50%

[Install]
WantedBy=default.target
