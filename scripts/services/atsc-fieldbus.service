[Unit]
Description=Actuated Traffic Signal Controller (ATSC) Field Bus
After=atsc-controller.service

[Service]
Type=forking

WorkingDirectory=/home/atsc/atsc-async
ExecStart=/bin/sh /home/atsc/atsc-async/scripts/services/start-fieldbus.sh
ExecStop=/bin/sh /home/atsc/atsc-async/scripts/services/stop-fieldbus.sh

TimeoutSec=30
SuccessExitStatus=1

MemoryMax=64M
CPUQuota=50%

[Install]
WantedBy=default.target
